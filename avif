#!/bin/bash

# Create a cinemagraph from a few seconds of 120fps video.

if [[ -z "$1" ]]
then
    echo "Usage: avif video.MOV [00:00:01.5 00:00:02.5]"
    exit 1
fi

zoom=1
stretch=5
filter="setpts=$stretch*PTS,fps=24,
        scale=iw*$zoom:ih*$zoom,
        crop=round((ih/$zoom)*610/377/2)*2:round(ih/$zoom/2)*2:(iw-ow)/2:(ih-oh)/2"
input="$1"
output="${1%.*}.avif"
thumbnail="${1%.*}.thumbnail.avif"

if [[ -n "$3" ]]
then
    from="$2"
    to="$3"

    ffmpeg \
        -ss "$from" \
        -to "$to" \
        -i "$input" \
        -vf "$filter,
             format=yuv420p" \
        -c:v libsvtav1 \
        -crf 28 \
        -preset 8 \
        "$output"
    ffmpeg \
        -ss "$from" \
        -to "$to" \
        -i "$input" \
        -vf "$filter,
             scale=610:376,
             format=yuv420p" \
        -c:v libsvtav1 \
        -crf 28 \
        -preset 8 \
        "$thumbnail"
    mv "$thumbnail" "${thumbnail%.avif}"
else
    ffmpeg \
        -i "$input" \
        -vf "$filter,
             format=yuv420p" \
        -c:v libsvtav1 \
        -crf 28 \
        -preset 8 \
        "$output"
    ffmpeg \
        -i "$input" \
        -vf "$filter,
             scale=610:376,
             format=yuv420p" \
        -c:v libsvtav1 \
        -crf 28 \
        -preset 8 \
        "$thumbnail"
    mv "$thumbnail" "${thumbnail%.avif}"
fi
