#!/bin/bash

# Create a cinemagraph from a few seconds of 100fps video.

if [[ -z "$1" ]]
then
    echo "Usage: avif video.MOV 00:00:01.5 00:00:02.5"
    exit 1
fi

input="$1"
output="${1%.*}.avif"

if [[ -n "$3" ]]
then
   from="$2"
   to="$3"

   ffmpeg \
       -ss "$from" \
       -to "$to" \
       -r 100 \
       -i "$input" \
       -vf "setpts=4*PTS,
            crop=ih*(1+sqrt(5))/2:ih,
            format=yuv420p" \
       -c:v libsvtav1 \
       -crf 8 \
       -preset 8 \
       -r 25 \
       "$output"
else
    ffmpeg \
        -r 100 \
        -i "$input" \
        -vf "setpts=4*PTS,
             crop=ih*(1+sqrt(5))/2:ih,
             format=yuv420p" \
        -c:v libsvtav1 \
        -crf 8 \
        -preset 8 \
        -r 25 \
        "$output"
fi
