#!/bin/bash

# Convert video to animated AVIF.

if [[ $# -lt 3 ]]
then
    echo "Usage: avif video.MOV 00:00:01.5 00:00:02.5"
    exit 1
fi

input="$1"
output="${1%.*}.avif"

if [[ -n "$3" ]]
then
   from="$2"
   to="$3"

   ffmpeg \
       -ss "$from" \
       -to "$to" \
       -i "$input" \
       -c:v libsvtav1 \
       "$output"
else
    ffmpeg \
       -i "$input" \
       -c:v libsvtav1 \
       "$output"

