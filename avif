#!/bin/bash

# Convert video to animated AVIF.

if [[ -z "$1" ]]
then
    echo "Usage: avif video.MOV 00:00:01.5 00:00:02.5"
    exit 1
fi

input="$1"
output="${1%.*}.avif"

if [[ -n "$3" ]]
then
   from="$2"
   to="$3"

   ffmpeg \
       -ss "$from" \
       -to "$to" \
       -r 30 \
       -i "$input" \
       -vf "setpts=4*PTS,\
            zscale=t=smpte2084" \
       -r 7.5 \
       -c:v libsvtav1 \
       -pix_fmt yuv420p10le \
       -colorspace bt2020nc \
       -color_trc smpte2084 \
       -color_primaries bt2020 \
       -crf 12 \
       -preset 4 \
       "$output"
else
    ffmpeg \
       -r 30 \
       -i "$input" \
       -vf "setpts=4*PTS,\
            zscale=t=smpte2084" \
       -r 7.5 \
       -c:v libsvtav1 \
       -pix_fmt yuv420p10le \
       -colorspace bt2020nc \
       -color_trc smpte2084 \
       -color_primaries bt2020 \
       -crf 12 \
       -preset 4 \
       "$output"
fi

exiftool \
    -TagsFromFile "$input" \
    '-FileModifyDate<QuickTime:CreateDate' \
    "$output"
